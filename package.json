{
  "name": "pacs008.github.io",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./build.sh --serve",
    "serve": "python3 -m http.server 8000 --directory public --bind 127.0.0.1",
    "build": "./build.sh",
    "check": "ssg check -f config.toml",
    "audit": "ssg audit -f config.toml",
    "validate": "html-validate 'public/**/*.html'",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "./build.sh && npm test && node scripts/validate-all-locales.mjs && node scripts/audit-full-compliance.mjs && npm run lighthouse && npm run mobile",
    "lighthouse": "node scripts/check-lighthouse.mjs",
    "wave": "node scripts/check-wave.mjs",
    "check:cdn-icon": "node scripts/check-cdn-icon.mjs",
    "mobile": "node scripts/check-mobile-overflow.mjs"
  },
  "devDependencies": {
    "axe-core": "4.12.1",
    "happy-dom": "20.11.1",
    "html-validate": "10.11.2",
    "lighthouse": "13.4.1",
    "vitest": "4.1.1",
    "xmllint-wasm": "5.2.0"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "version": ""
}
